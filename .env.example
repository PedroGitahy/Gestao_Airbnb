# Banco PostgreSQL (o Easypanel mostra essa URL no serviço Postgres)
DATABASE_URL=postgres://usuario:senha@host:5432/rgr_artem
# Segredo das sessões: gere com `openssl rand -base64 32`
AUTH_SECRET=troque-por-um-segredo-longo
# Primeiro administrador (criado só se ainda não houver usuários)
ADMIN_EMAIL=pedro@rgr-ia.com
ADMIN_PASSWORD=troque-esta-senha
# Endereço público
SITE_URL=https://artem.rgr-ia.com
# Intervalo da sincronização iCal, em minutos
ICAL_SYNC_MINUTES=30
# Chave para o agente de IA (n8n) consultar a central. Gere com `openssl rand -hex 24`
AGENT_API_KEY=
# IA (qualquer API compatível com OpenAI; padrão Groq)
AI_API_KEY=
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=llama-3.3-70b-versatile
# WhatsApp da central pela Evolution API (o mesmo servidor do seu agente)
EVOLUTION_URL=
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
